# ══════════════════════════════════════════════════════════════════════════════
# Incident Response Copilot — .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Secrets / environment files ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
backend/.env
**/.env

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/
**/.venv/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.installed.cfg
wheels/

# Testing & coverage
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# Type checkers
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ─── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
**/node_modules/
frontend/node_modules/

# Next.js build output
.next/
**/.next/
frontend/.next/
out/
frontend/out/

# Next.js cache
frontend/.swc/

# ─── Terraform ────────────────────────────────────────────────────────────────
# State files (may contain secrets)
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform working directory
**/.terraform/
.terraform/
.terraform.lock.hcl

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
# Exception: keep example/template tfvars
!*.tfvars.example

# Terraform plan output
*.tfplan

# ─── Google Cloud / GCP ───────────────────────────────────────────────────────
# Service account key files — never commit these
*-service-account.json
*-key.json
service-account*.json
keyfile.json
gcp-key.json
credentials.json
application_default_credentials.json

# ─── IDE / editors ────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc build artifacts ─────────────────────────────────────────────────────
*.tgz
*.zip
